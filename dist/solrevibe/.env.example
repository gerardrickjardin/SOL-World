# Stripe Credentials — EXAMPLE FILE (safe to commit)
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file.

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Optional webhook signing secret for Stripe webhook verification
# STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Your deployed site URL (Vercel sets VERCEL_URL automatically in production)
SITE_URL=http://localhost:3000

# ---- Form Security, CAPTCHA & Vision Control (CRM) Integration ----
# Keep VC_INTEGRATION_ENABLED=false while Vision Control is paused!
VC_INTEGRATION_ENABLED=false
VC_WEBHOOK_URL=
# Optional Vision Control Private Integration key + location ID for CRM duplicate contact lookup
VC_API_KEY=
VC_LOCATION_ID=

# Invisible CAPTCHA (Primary: Cloudflare Turnstile; Fallback: Google reCAPTCHA v3)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Random secret for signing rate-limit/timing/duplicate prevention tokens
FORM_SECURITY_SECRET=

# Optional Upstash/Vercel KV Redis REST credentials for cross-region rate limit & dedup persistence
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional Google Apps Script URL for verified leads / TLC session reflections
LEADS_GOOGLE_SHEETS_WEBAPP_URL=
TLC_GOOGLE_SHEETS_WEBAPP_URL=
