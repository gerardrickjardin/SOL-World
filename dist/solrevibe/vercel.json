{
  "cleanUrls": true,
  "regions": ["iad1"],
  "redirects": [
    {
      "source": "/video-library",
      "destination": "/tags",
      "permanent": true
    },
    {
      "source": "/video-library/index.html",
      "destination": "/tags",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
