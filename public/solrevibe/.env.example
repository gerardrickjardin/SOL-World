# Authorize.net Credentials — EXAMPLE FILE (safe to commit)
# Copy this file to .env and fill in your real values.
# NEVER commit your actual .env file.

AUTHORIZENET_API_LOGIN_ID=your_api_login_id_here
AUTHORIZENET_TRANSACTION_KEY=your_transaction_key_here

# Use 'sandbox' for testing, 'production' for live transactions
AUTHORIZENET_ENV=sandbox

# Your deployed site URL (Vercel sets VERCEL_URL automatically in production)
# Only needed for local dev:
SITE_URL=http://localhost:3000
